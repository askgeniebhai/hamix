# Copy to .env.local and fill in real values for local development.
# Never commit .env.local or any file containing real secrets.

# PostgreSQL connection string (Neon: copy from your Neon project's
# "Connection Details" panel — use the pooled connection string).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Better Auth session-signing secret. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-generated-32-plus-character-secret"

# Base URL Better Auth uses to construct callback URLs.
BETTER_AUTH_URL="http://localhost:3000"
